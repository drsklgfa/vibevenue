APP_ENCRYPTION_KEY_PREVIOUS=
BACKUP_ENCRYPTION_KEY=
BACKUP_REQUIRE_ENCRYPTION=true
MFA_ISSUER=VibeVenue
MFA_REQUIRED_ROLES=owner
MFA_CHALLENGE_MINUTES=10
MFA_MAX_ATTEMPTS=5
STEP_UP_MINUTES=10
MFA_CHALLENGE_COOKIE_NAME=vv_mfa
DISTRIBUTED_RATE_LIMIT=true
MEDIA_SCAN_MODE=optional
CLAMAV_HOST=
CLAMAV_PORT=3310
MEDIA_MAX_BYTES=8388608
MEDIA_MAX_PIXELS=40000000
MEDIA_MAX_DIMENSION=1600
TRUST_PROXY_HOPS=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_COOKIE_NAME=vv_admin
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=
RETURN_ADMIN_TOKEN=true
STORAGE_DRIVER=local
UPLOAD_DIR=./apps/server/uploads
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_FORCE_PATH_STYLE=true
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
