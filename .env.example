DATABASE_SSL=false
REDIS_URL=redis://localhost:6379
REQUIRE_CLOUD_SERVICES=false
DEMO_MODE=true
AUTO_MIGRATE=true
AUTO_SEED_DEMO=true
SESSION_TTL_DAYS=30
ADMIN_SESSION_ABSOLUTE_HOURS=720
PLATFORM_SESSION_ABSOLUTE_HOURS=8
ADMIN_SESSION_IDLE_MINUTES=60
PLATFORM_SESSION_IDLE_MINUTES=30
SESSION_TOUCH_MINUTES=5
GUEST_SESSION_TTL_HOURS=12
MAINTENANCE_INTERVAL_MINUTES=60
BILLING_GRACE_DAYS=5
EXPIRED_GUEST_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=730
AUDIT_IP_SALT=
TOKEN_HASH_PEPPER=
APP_ENCRYPTION_KEY=
